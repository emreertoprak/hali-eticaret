# JSON config dosyasındaki değerleri ezer (opsiyonel)
HALI_API_CONFIG_PATH=./config/settings.dev.json
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hali
DB_PASSWORD=hali
DB_NAME=hali
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=

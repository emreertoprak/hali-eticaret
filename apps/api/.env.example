# Vitrin adresi (PayTR dönüş URL'leri için)
PUBLIC_WEB_URL=http://localhost:3000
# Ödeme: mock | paytr
PAYMENT_PROVIDER=mock
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=

{
  "name": "hali-eticaret-api",
  "version": "1.0.0",
  "private": true,
  "description": "Halı e-ticaret REST API (Express + Knex/MySQL + Redis).",
  "main": "dist/server.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:bundle",
    "build:bundle": "node scripts/build.mjs",
    "build:obfuscate": "node scripts/obfuscate.mjs",
    "build:prod": "npm run build:bundle && npm run build:obfuscate",
    "start": "node dist/server.js",
    "dev": "HALI_API_CONFIG_PATH=./config/settings.dev.json ts-node -r tsconfig-paths/register src/Server.ts",
    "test": "jest --runInBand",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "sonar": "node node_modules/sonarqube-scanner/src/bin/sonar-scanner",
    "knex": "HALI_API_CONFIG_PATH=${HALI_API_CONFIG_PATH:-./config/settings.dev.json} knex --knexfile knexfile.ts",
    "migrate:latest": "npm run knex -- migrate:latest",
    "migrate:rollback": "npm run knex -- migrate:rollback",
    "migrate:make": "npm run knex -- migrate:make -x ts",
    "seed:run": "npm run knex -- seed:run"
  },
  "author": "Yunus Emre Ertoprak",
  "license": "ISC",
  "overrides": {
    "tar": "^7.5.11"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.2.1",
    "express-useragent": "^1.0.15",
    "file-stream-rotator": "^0.6.1",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "log4js": "^6.9.1",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "rate-limit-redis": "^4.2.0",
    "reflect-metadata": "^0.2.1",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/express-useragent": "^1.0.2",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.39",
    "@types/supertest": "^2.0.16",
    "@types/swagger-ui-express": "^4.1.6",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "ioredis-mock": "^8.9.0",
    "javascript-obfuscator": "^5.4.1",
    "jest": "^29.7.0",
    "sonarqube-scanner": "^3.5.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.58.1"
  }
}
